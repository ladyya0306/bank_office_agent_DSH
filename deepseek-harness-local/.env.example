# DeepSeek Harness Configuration
# Copy this file to .env and fill in your values

# DeepSeek API Key (required)
# Get it from https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_api_key_here

# 北京百炼普通按量API：只将密钥填在等号后，不替换上面的DeepSeek密钥。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# 本地服务仅监听127.0.0.1；setup-qwen会自动生成本地访问密钥，无需手填。
LOCAL_QWEN_API_KEY=
LOCAL_QWEN_SERVER=
LOCAL_QWEN_MODEL_PATH=
LOCAL_QWEN_PORT=18081
LOCAL_QWEN_CONTEXT=32768
LOCAL_QWEN_THREADS=6

# Optional: Custom workspace directory (default: ./workspace)
# WORKSPACE_DIR=./workspace

# Optional: Custom port for Web UI (default: 3080)
# PORT=3080

# Optional: Custom host (default: 127.0.0.1)
# HOST=127.0.0.1

# Optional: Log level (debug, info, warn, error)
# LOG_LEVEL=info

# 已安装4B后启用；模型和运行程序均保存在DSH/model目录。
LOCAL_QWEN4_AUTOSTART=0
LOCAL_QWEN4_SERVER=D:/DSH/model/runtime/b10964/llama-server.exe
LOCAL_QWEN4_MODEL_PATH=D:/DSH/model/Qwen_Qwen3-4B-Instruct-2507-Q4_K_M.gguf
LOCAL_QWEN4_PORT=18082
LOCAL_QWEN4_CONTEXT=32768
LOCAL_QWEN4_THREADS=6
