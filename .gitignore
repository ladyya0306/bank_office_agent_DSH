# 默认不把办公电脑上的文件加入仓库，只开放程序与公开说明。
/*
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/THIRD_PARTY_NOTICES.md
!/release-docs/
!/scripts/
!/config-examples/
!/toolV2/
!/deepseek-harness-local/

/toolV2/*
!/toolV2/AGENTS.md
!/toolV2/README.md
!/toolV2/engine-origin.json
!/toolV2/office.py
!/toolV2/install.py
!/toolV2/接入DSH.cmd
!/toolV2/requirements-core.txt
!/toolV2/requirements-office-optional.txt
!/toolV2/office_kit/
!/toolV2/workflow/
!/toolV2/dsh-plugin/
!/toolV2/hooks/
!/toolV2/skills/
!/toolV2/tests/
!/toolV2/template_rules_verified/

/deepseek-harness-local/*
!/deepseek-harness-local/.gitignore
!/deepseek-harness-local/.env.example
!/deepseek-harness-local/package.json
!/deepseek-harness-local/package-lock.json
!/deepseek-harness-local/start.js
!/deepseek-harness-local/patch-fence.cjs
!/deepseek-harness-local/question-detail.cjs
!/deepseek-harness-local/tool-v2-startup.cjs
!/deepseek-harness-local/runtime-logging.cjs
!/deepseek-harness-local/tests/
!/deepseek-harness-local/workspace/
/deepseek-harness-local/workspace/*
!/deepseek-harness-local/workspace/plugins/
/deepseek-harness-local/workspace/plugins/*
!/deepseek-harness-local/workspace/plugins/bank-approval/
!/deepseek-harness-local/workspace/plugins/bank-approval-ui/
!/deepseek-harness-local/workspace/plugins/session-workspace-gate/
!/deepseek-harness-local/workspace/plugins/session-directory-picker-zh/

**/node_modules/
**/__pycache__/
**/.pytest_cache/
**/.env
**/.credentials*
**/*.db
**/*.db-*
**/*.sqlite*
**/*.jsonl*
**/*.zstd
**/*.log
**/*.pyc
**/*.bak
**/*.docx
**/*.xlsx
**/*.pdf
**/*.png
**/*.jpg
